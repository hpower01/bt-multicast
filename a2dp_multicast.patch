+/*****************************************************************************
+ * A2DP Source multicast
+ *
+ * When persist.bluetooth.a2dp_multicast.enabled is true, the audio encoded
+ * for the active peer is also streamed to every other connected A2DP Sink.
+ * BTA AV already duplicates each media packet to all started streams
+ * (bta_av_dup_audio_buf), so btif only needs to start the non-active peers
+ * and keep them started. The encoder and the audio HAL session stay owned by
+ * the active peer.
+ *****************************************************************************/
+static bool btif_av_src_multicast_enabled() {
+  return osi_property_get_bool("persist.bluetooth.a2dp_multicast.enabled",
+                               false);
+}
+
+// A non-active peer can receive the duplicated packets only if it negotiated
+// the same codec format as the active peer (there is a single encoder).
+static bool btif_av_src_multicast_peer_compatible(const BtifAvPeer& peer) {
+  if (!peer.IsSink() || peer.IsActivePeer()) return false;
+  A2dpCodecConfig* active_codec = bta_av_get_a2dp_current_codec();
+  A2dpCodecConfig* peer_codec =
+      bta_av_get_a2dp_peer_current_codec(peer.PeerAddress());
+  if (active_codec == nullptr || peer_codec == nullptr) return false;
+  if (active_codec->codecIndex() != peer_codec->codecIndex()) {
+    LOG_WARN("%s: Peer %s : codec %d differs from active codec %d", __func__,
+             peer.PeerAddress().ToString().c_str(),
+             static_cast<int>(peer_codec->codecIndex()),
+             static_cast<int>(active_codec->codecIndex()));
+    return false;
+  }
+  btav_a2dp_codec_config_t a = active_codec->getCodecConfig();
+  btav_a2dp_codec_config_t p = peer_codec->getCodecConfig();
+  if (a.sample_rate != p.sample_rate || a.channel_mode != p.channel_mode ||
+      a.bits_per_sample != p.bits_per_sample) {
+    LOG_WARN("%s: Peer %s : codec parameters differ from the active peer",
+             __func__, peer.PeerAddress().ToString().c_str());
+    return false;
+  }
+  return true;
+}
+
+static bool btif_av_src_multicast_peer(const BtifAvPeer& peer) {
+  return btif_av_src_multicast_enabled() &&
+         btif_av_src_multicast_peer_compatible(peer);
+}
+
+// Start every opened, compatible, non-active sink. Runs on the main thread.
+static void btif_av_src_multicast_start_peers() {
+  if (!btif_av_src_multicast_enabled()) return;
+  auto start_peers = []() {
+    for (auto it : btif_av_source.Peers()) {
+      const BtifAvPeer* peer = it.second;
+      if (peer->StateMachine().StateId() != BtifAvStateMachine::kStateOpened)
+        continue;
+      if (peer->CheckFlags(BtifAvPeer::kFlagPendingStart |
+                           BtifAvPeer::kFlagRemoteSuspend |
+                           BtifAvPeer::kFlagPendingStop))
+        continue;
+      if (!btif_av_src_multicast_peer_compatible(*peer)) continue;
+      LOG_INFO("%s: starting multicast peer %s", __func__,
+               peer->PeerAddress().ToString().c_str());
+      btif_av_source_dispatch_sm_event(peer->PeerAddress(),
+                                       BTIF_AV_START_STREAM_REQ_EVT);
+    }
+  };
+  do_in_main_thread(FROM_HERE, base::Bind(start_peers));
+}
+
